---
// 404: bulunamayan her adres için gösterilir. Cloudflare Pages, dist/404.html dosyasını kendiliğinden kullanır.
import Layout from '../layouts/Layout.astro';
---

<Layout baslik="Sayfa bulunamadı" aciklama="Aradığınız sayfa bulunamadı." indekslenmesin>
  <section class="bolum">
    <div class="kap orta">
      <img src="/img/bos-fincan.svg" width="320" height="240" alt="Devrilmiş, kahvesi dökülmüş bir fincan ve yanında soru işareti" />
      <p class="kod">404</p>
      <h1>Bu fincan boş çıktı.</h1>
      <p>Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Adresi kontrol edin veya aşağıdan devam edin.</p>
      <div class="dugmeler">
        <a class="dugme" href="/">Ana sayfaya dön</a>
        <a class="dugme ikincil" href="/menu/">Menüye bak</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .orta {
    text-align: center;
    max-width: 640px;
  }
  .orta img {
    margin: 0 auto;
  }
  .kod {
    font-family: var(--baslik-font);
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    color: var(--yesil);
    margin: 8px 0 0;
  }
  .dugmeler {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
