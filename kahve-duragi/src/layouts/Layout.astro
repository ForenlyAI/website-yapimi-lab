---
// Layout: her sayfanın ortak iskeleti — <head> etiketleri, üst menü, alt bilgi.
// Sayfalar bu bileşeni sarar ve yalnız kendi içeriklerini <slot /> yerine koyar.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  baslik: string;
  aciklama?: string;
  gorsel?: string;
  indekslenmesin?: boolean;
}

const {
  baslik,
  aciklama = SITE.aciklama,
  gorsel = '/og-kahve-duragi.png',
  indekslenmesin = false,
} = Astro.props;

const tamBaslik = baslik === SITE.ad ? `${SITE.ad} · ${SITE.slogan}` : `${baslik} · ${SITE.ad}`;
const adres = new URL(Astro.url.pathname, Astro.site);
const gorselAdres = new URL(gorsel, Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={adres} />
    {indekslenmesin && <meta name="robots" content="noindex" />}

    <!-- Paylaşım kartı (WhatsApp, LinkedIn, X vb.) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE.ad} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:url" content={adres} />
    <meta property="og:image" content={gorselAdres} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kahve Durağı logosu ve buharı tüten bir fincan" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2b1d16" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/baloo-2-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="atla" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
  </body>
</html>
